VITE_API_BASE_URL=/api

# Axios request timeout (ms)
VITE_AXIOS_TIMEOUT_MS=15000

# Idle/inactivity auto-logout window (ms) — 7.5 minutes by default
VITE_SESSION_TIMEOUT_MS=450000

# How often the client re-polls the permissions matrix for cross-device sync (ms)
VITE_PERMISSIONS_POLL_MS=20000

# Plus-size recommendation tolerances (percent, as decimals)
VITE_PLUS_SIZE_HEIGHT_TOLERANCE_PCT=0.03
VITE_PLUS_SIZE_TREAD_TOLERANCE_PCT=0.15